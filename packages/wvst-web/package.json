{
  "name": "@wvst/web",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "WebAudio SDK for isolated local VST3 processing through the WVST Rust Bridge.",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bridge-worker": {
      "import": "./dist/esm/audio/bridge-worker.js"
    },
    "./loopback-processor": {
      "import": "./dist/esm/audio/loopback-processor.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && rollup -c",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke:bridge": "node scripts/browser-bridge-smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "vitest": "^4.1.8"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backrunner/wvst.git",
    "directory": "packages/wvst-web"
  }
}

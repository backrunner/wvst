{
  "name": "@wvst/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebAudio client SDK skeleton for WVST.",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bridge-worker": {
      "import": "./dist/esm/audio/bridge-worker.js"
    },
    "./loopback-processor": {
      "import": "./dist/esm/audio/loopback-processor.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && rollup -c",
    "check": "tsc -p tsconfig.json --noEmit",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "vitest": "^4.1.8"
  }
}

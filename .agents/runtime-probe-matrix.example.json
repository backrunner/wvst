{
  "schemaVersion": 1,
  "description": "Example WVST runtime-probe matrix. Set WVST_VST3_FIXTURE_ROOT to a directory containing local third-party VST3 fixtures, then replace classId values before running.",
  "fixtureRoot": "${WVST_VST3_FIXTURE_ROOT}",
  "evidenceRequirements": {
    "requireAllCasesEvidence": true,
    "minThirdPartyCases": 2,
    "minThirdPartyEffectCases": 1,
    "minThirdPartyInstrumentCases": 1,
    "minThirdPartyBlocks": 8,
    "minThirdPartyProcessFrames": 1024,
    "minThirdPartyTimeoutMillis": 30000,
    "requireThirdPartyExpectations": true,
    "requireThirdPartyAudioHealthExpectations": true,
    "requireThirdPartyProcessTimingExpectations": true,
    "requireThirdPartyRuntimeHealthExpectations": true,
    "requireThirdPartyNoteResponseExpectations": true,
    "requireThirdPartyControllerRichExpectations": true,
    "requireThirdPartyOutputEventExpectations": true,
    "requiredTags": ["automation", "note-response"],
    "requiredThirdPartyTagCounts": {
      "controller-rich": 1,
      "note-response": 1,
      "output-events": 1
    }
  },
  "cases": [
    {
      "name": "effect-stereo-automation",
      "pluginPath": "ExampleEffect.vst3",
      "classId": "00000000000000000000000000000000",
      "evidence": {
        "pluginName": "Example Effect",
        "vendor": "Example Vendor",
        "pluginVersion": "1.0.0",
        "pluginKind": "effect",
        "thirdParty": true,
        "tags": ["effect", "automation", "controller-rich", "output-events"]
      },
      "sampleRateHz": 48000,
      "maxBlockFrames": 128,
      "inputChannels": 2,
      "outputChannels": 2,
      "frames": 128,
      "blocks": 16,
      "timeoutMillis": 30000,
      "controllerEditProbeParameterId": 42,
      "parameterChanges": [
        {
          "parameterId": 42,
          "valueMilli": 500,
          "sampleOffset": 64
        }
      ],
      "expectations": {
        "expectedStatus": "passed",
        "minParameterCount": 1,
        "minAutomatableParameters": 1,
        "requireComponentState": true,
        "minComponentStateBytes": 1,
        "requireComponentStateRoundtrip": true,
        "requireControllerState": true,
        "minControllerStateBytes": 1,
        "requireControllerStateRoundtrip": true,
        "requireControllerComponentStateSync": true,
        "minControllerComponentStateSyncBytes": 1,
        "requireUnitInfo": true,
        "minUnitCount": 1,
        "minProgramListCount": 1,
        "minTotalPrograms": 1,
        "requireProgramListData": true,
        "minProgramListDataSupported": 1,
        "requireUnitData": true,
        "minUnitDataSupported": 1,
        "requireComponentHandler": true,
        "requireComponentHandlerEditProbe": true,
        "minComponentHandlerEvents": 3,
        "requireConnectionPoints": true,
        "requireConnectionNotifyProbe": true,
        "maxNonFiniteOutputSamples": 0,
        "maxClippedOutputSamples": 0,
        "expectedInputBusIndex": 0,
        "expectedOutputBusIndex": 0,
        "expectedInputBusChannels": 2,
        "expectedOutputBusChannels": 2,
        "minAdvancedPayloadEvents": 1,
        "minAdvancedPayloadBytes": 1,
        "maxAdvancedTruncatedPayloadEvents": 0,
        "maxAdvancedUnavailablePayloadEvents": 0,
        "maxAdvancedInvalidTextPayloadEvents": 0,
        "maxFilteredOutputEvents": 0,
        "maxFilteredOutputParameterChanges": 0,
        "maxProcessTimeP95Micros": 2000,
        "maxProcessTimeP99Micros": 4000,
        "maxProcessTimeMaxMicros": 8000,
        "maxLatencySamples": 4096,
        "maxTailSamples": 96000,
        "requireTailInfo": true,
        "expectedTailKind": "finite",
        "maxOutputPeakMilli": 1000
      }
    },
    {
      "name": "instrument-zero-input-note",
      "pluginPath": "ExampleInstrument.vst3",
      "classId": "00000000000000000000000000000000",
      "evidence": {
        "pluginName": "Example Instrument",
        "vendor": "Example Vendor",
        "pluginVersion": "1.0.0",
        "pluginKind": "instrument",
        "thirdParty": true,
        "tags": ["instrument", "note-response", "zero-input"]
      },
      "sampleRateHz": 48000,
      "maxBlockFrames": 128,
      "inputChannels": 0,
      "outputChannels": 2,
      "frames": 128,
      "blocks": 16,
      "timeoutMillis": 30000,
      "note": {
        "pitch": 60,
        "velocityMilli": 750,
        "channel": 0
      },
      "expectations": {
        "expectedStatus": "passed",
        "requireNonZeroOutput": true,
        "requireNoteResponse": true,
        "maxNoteToAudioFrames": 2048,
        "maxNoteToAudioMicros": 50000,
        "maxNonFiniteOutputSamples": 0,
        "maxClippedOutputSamples": 0,
        "requireNoInputBus": true,
        "expectedOutputBusIndex": 0,
        "expectedOutputBusChannels": 2,
        "maxFilteredOutputEvents": 0,
        "maxFilteredOutputParameterChanges": 0,
        "maxProcessTimeP95Micros": 3000,
        "maxProcessTimeP99Micros": 6000,
        "maxProcessTimeMaxMicros": 12000,
        "maxLatencySamples": 4096,
        "maxTailSamples": 192000,
        "requireTailInfo": true,
        "expectedTailKind": "finite",
        "requiredProcessContextRequirements": 0,
        "minOutputRmsMilli": 1,
        "maxOutputPeakMilli": 1000
      }
    }
  ]
}
